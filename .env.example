# Copy to .env before running `docker compose up`.
# SQL Server enforces a password complexity policy (upper+lower+digit+symbol, 8+ chars).
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
MSSQL_DATABASE=ecommerce

FAILURE_RATE=0.3

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Aviso no Telegram quando a DAG bulk_load_dimensions terminar (sucesso ou
# falha). Opcional: sem essas duas variáveis, a notificação é só pulada
# (com um aviso no log), a DAG não quebra por causa disso.
# Crie um bot com o @BotFather e pegue seu chat_id com @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
